<Project>

  <!--
    禁止 .NET SDK 在 InformationalVersion 中追加 Git 提交哈希后缀（如 +14a6b2c）。
    SDK 的 GenerateAssemblyInfo 目标默认将 SourceRevisionId 追加到 InformationalVersion，
    此属性从源头关闭该行为，对所有子项目生效。
  -->
  <PropertyGroup>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- 禁用 Avalonia 构建期遥测任务（AvaloniaStatsTask）：
       sandbox 拦截写入 C:\Users\...\AppData\Local\AvaloniaUI\BuildServices\buildtasks.log，
       导致 Avalonia.BuildServices.targets 的 AvaloniaStats target 抛 UnauthorizedAccessException。
       通过将 Condition 改为 false 让 target 不执行。 -->
  <Target Name="AvaloniaStats" Condition="false" BeforeTargets="CoreCompile" />
</Project>
