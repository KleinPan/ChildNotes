# ChildNotes NAS 部署 .env 示例
#
# 用途：在 NAS 上与 docker-compose.yml 同目录放置一个 .env 文件，
#      填入真实值后由 docker compose 自动读取注入容器环境变量。
#
# 复制此文件为 .env 并填入实际值：
#   cp nas.env.example .env
#   nano .env
#
# ⚠ 此文件包含敏感信息，切勿提交到 git（已在 .dockerignore / .gitignore 中排除）。

# ---- 镜像版本 ----
# 留空使用 docker-compose.yml 中的默认值 latest
# 指定版本可固定为某次 CI 构建产物，如 0.5.4
IMAGE_TAG=latest

# ---- 端口 ----
# API 对外暴露端口（NAS 防火墙需放行）
API_PORT=8080
# PostgreSQL 对外暴露端口（如不需要外部访问可注释掉 compose 中的 ports 段）
DB_PORT=5432

# ---- 数据库 ----
DB_NAME=child_notes
DB_USER=postgres
# 生产环境必须改！至少 16 字符强密码
DB_PASSWORD=please-change-me

# ---- JWT ----
# 生产环境必须改！至少 32 字符随机字符串
# 生成方式：openssl rand -base64 48
JWT_SECRET=please-change-this-default-jwt-secret-key-at-least-32-chars

# ---- Admin 初始账号 ----
# 首次启动时自动创建，之后可在管理后台修改密码
ADMIN_PASSWORD=please-change-me

# ---- DeepSeek AI（可选，不配则 AI 功能不可用） ----
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
