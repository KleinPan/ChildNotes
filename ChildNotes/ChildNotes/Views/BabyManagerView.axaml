<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChildNotes.ViewModels"
             xmlns:m="using:ChildNotes.Models"
             xmlns:v="using:ChildNotes.Views"
             xmlns:controls="using:ChildNotes.Controls"
             xmlns:shared="using:ChildNotes.Shared.Dtos"
             xmlns:sharedConst="using:ChildNotes.Shared.Constants"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:Class="ChildNotes.Views.BabyManagerView"
             x:DataType="vm:BabyManagerViewModel"
             Background="{StaticResource SurfaceBackgroundBrush}">

    <UserControl.Styles>
        <!-- 抽屉动画由 code-behind 用 Animation KeyFrame API 驱动，无需 XAML Transitions -->

        <!-- 抽屉遮罩层：全屏半透明黑底，盖住底层内容 -->
        <Style Selector="Border.drawer-mask">
            <Setter Property="Background" Value="{StaticResource MaskBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <!-- 抽屉面板：底部弹出，圆角顶部，最大高度限制 -->
        <Style Selector="Border.drawer-panel">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style Selector="Button.gender-btn">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Background" Value="{StaticResource SurfaceDisabledBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.gender-btn.active">
            <Setter Property="Background" Value="{StaticResource BrandPrimaryLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.gender-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceDisabledBrush}"/>
        </Style>
        <Style Selector="Button.gender-btn.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandPrimaryLightBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- 列表面板（合并宝宝管理 + 家人管理） -->
        <Border Background="{StaticResource SurfaceBackgroundBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- 统一顶栏 -->
                <Border Grid.Row="0" Classes="nav-bar">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Classes="nav-back" Command="{Binding BackCommand}"/>
                        <TextBlock Grid.Column="1" Classes="nav-title" Text="{DynamicResource BabyMgr_Title}"/>
                        <TextBlock Grid.Column="2" Text=" " Width="40"/>
                    </Grid>
                </Border>

                <!-- 列表 / 空态 -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="0,12">
                    <StackPanel>
                        <!-- 空态 -->
                        <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="{StaticResource Radius.Small}" Margin="12,4" Padding="20,40"
                                IsVisible="{Binding !HasBaby}">
                            <StackPanel HorizontalAlignment="Center" Spacing="8">
                                <TextBlock Text="🍼" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource BabyMgr_EmptyTitle}" FontSize="{StaticResource FontSize.Body}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource BabyMgr_EmptyHint}" FontSize="{StaticResource FontSize.Label}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 宝宝列表（每个卡片下方含家人区域） -->
                        <ItemsControl ItemsSource="{Binding BabyList}" IsVisible="{Binding HasBaby}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:Baby">
                                    <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="{StaticResource Radius.Small}" Margin="12,4" Padding="0">
                                        <StackPanel>
                                            <!-- 宝宝信息行（点击进入编辑） -->
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="14,12"
                                                  PointerPressed="OnBabyItemTapped">
                                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="{StaticResource Radius.Pill}" Background="{StaticResource BrandPrimaryLightBrush}" VerticalAlignment="Center" ClipToBounds="True">
                                                    <Panel>
                                                        <!-- 有头像时显示图片（异步加载，不阻塞 UI 线程） -->
                                                        <controls:AvatarImage Path="{Binding Avatar}" Stretch="UniformToFill"/>
                                                        <!-- 无头像时显示性别 emoji 占位 -->
                                                        <TextBlock Text="{Binding GenderEmoji}"
                                                                   FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   IsVisible="{Binding Avatar, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                                    </Panel>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSize.Body}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding BirthDateText}" FontSize="{StaticResource FontSize.Caption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="{StaticResource BrandPrimaryAlpha10Brush}" CornerRadius="{StaticResource Radius.Small}" Padding="8,2" VerticalAlignment="Center" Margin="8,0,4,0"
                                                        IsVisible="{Binding ., Converter={x:Static v:BabyManagerView.IsCurrentBabyConverter}}">
                                                    <TextBlock Text="{DynamicResource BabyMgr_Current}" FontSize="{StaticResource FontSize.Caption}" Foreground="{StaticResource BrandPrimaryBrush}"/>
                                                </Border>
                                                <TextBlock Grid.Column="3" Text="›" FontSize="20" Foreground="{StaticResource TextPlaceholderBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </Grid>

                                            <!-- 家人区域：仅在 Baby.Family 不为空时显示 -->
                                            <StackPanel IsVisible="{Binding Family, Converter={x:Static v:BabyManagerView.IsNotNullConverter}}">
                                                <Border Height="1" Background="{StaticResource SurfaceDividerBrush}" Margin="14,0"/>

                                                <!-- 宝宝 ID 行：宝宝主人可复制给家人用于加入家庭 -->
                                                <Grid Margin="14,10" ColumnDefinitions="Auto,*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{DynamicResource Family_BabyId}" FontSize="{StaticResource FontSize.Caption}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Family.BabyId}" FontSize="{StaticResource FontSize.Caption}"
                                                               Foreground="{StaticResource TextPlaceholderBrush}"
                                                               FontFamily="Consolas,Menlo,monospace"
                                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="2" Content="{DynamicResource Common_Copy}" Classes="btn small"
                                                            Click="OnCopyBabyIdTap" Tag="{Binding Family.BabyId}"/>
                                                </Grid>

                                                <!-- 家人标题行 -->
                                                <Grid Margin="14,4,14,0" ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" FontSize="{StaticResource FontSize.Label}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}">
                                                        <Run Text="{DynamicResource Personnel_FamilyPrefix}"/>
                                                        <Run Text="{Binding Family.Members.Count}"/>
                                                        <Run Text="{DynamicResource Personnel_FamilySuffix}"/>
                                                    </TextBlock>
                                                    <Button Grid.Column="1" Content="{DynamicResource Family_MyRole}" Classes="btn small"
                                                            Click="OnEditRoleTap" Tag="{Binding Family}"/>
                                                </Grid>

                                                <!-- 成员列表 -->
                                                <ItemsControl ItemsSource="{Binding Family.Members}" Margin="0,4,0,8">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="shared:BabyMemberDto">
                                                            <Grid Margin="14,8" ColumnDefinitions="Auto,*,Auto">
                                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource Radius.Pill}"
                                                                        Background="{StaticResource BrandPrimaryBrush}"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="👤" FontSize="18" Foreground="{StaticResource SurfaceCardBrush}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding NickName}" FontSize="{StaticResource FontSize.Label}" FontWeight="Medium"/>
                                                                        <TextBlock Text="{DynamicResource Family_Me}" FontSize="{StaticResource FontSize.Caption}" Foreground="{StaticResource BrandPrimaryBrush}"
                                                                                   IsVisible="{Binding Mine}" Margin="2,0,0,0"/>
                                                                        <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="{StaticResource Radius.XS}"
                                                                                Padding="4,1" Margin="6,0,0,0" IsVisible="{Binding Owner}">
                                                                            <TextBlock Text="{DynamicResource Family_Owner}" FontSize="{StaticResource FontSize.Caption}" Foreground="{StaticResource SurfaceCardBrush}"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding RoleName}" FontSize="{StaticResource FontSize.Caption}"
                                                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                                <!-- 操作区域：使用 Text Button（规范 5.1.6：危险操作入口用 Text Button，红色文字）
                                                                     自己且非 Owner：显示"退出"（Owner 不能退出，只能删除宝宝） -->
                                                                <Button Grid.Column="2" VerticalAlignment="Center"
                                                                        Content="{DynamicResource Family_LeaveButton}"
                                                                        Classes="btn text danger small"
                                                                        IsVisible="{Binding Converter={x:Static v:BabyManagerView.MineAndNotOwnerConverter}}"
                                                                        Tag="{Binding $parent[ItemsControl].((m:Baby)DataContext).Family}"
                                                                        Click="OnLeaveFamilyTap"/>
                                                                <!-- Owner 看到非自己、非 Owner 的成员：显示"移除" -->
                                                                <Button Grid.Column="2" VerticalAlignment="Center"
                                                                        Content="{DynamicResource Family_RemoveButton}"
                                                                        Classes="btn text danger small"
                                                                        IsVisible="{Binding Converter={x:Static v:BabyManagerView.AndOwnerConverter}}"
                                                                        Tag="{Binding $parent[ItemsControl].((m:Baby)DataContext).Family}"
                                                                        Click="OnRemoveMemberTap"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- 未加入家庭提示 -->
                                            <StackPanel IsVisible="{Binding Family, Converter={x:Static v:BabyManagerView.IsNullConverter}}"
                                                        Margin="14,4,14,10">
                                                <Border Height="1" Background="{StaticResource SurfaceDividerBrush}" Margin="0,0,0,8"/>
                                                <TextBlock Text="{DynamicResource Personnel_NoFamily}" FontSize="{StaticResource FontSize.Caption}"
                                                           Foreground="{StaticResource TextPlaceholderBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ===== 底部家人管理区域 ===== -->

                        <!-- 申请加入新家庭按钮（所有人可见，全宽底部按钮用 default 样式，避免 pill+stretch 变椭圆） -->
                        <Button Content="{DynamicResource Family_JoinById}" Classes="btn secondary large"
                                Margin="12,12" HorizontalAlignment="Stretch"
                                Click="OnJoinTap"/>

                        <!-- 待审批申请（owner 且有数据时可见） -->
                        <StackPanel IsVisible="{Binding HasPendingRequests}" Margin="12,4,12,0">
                            <TextBlock Text="{DynamicResource Family_PendingRequests}" FontSize="{StaticResource FontSize.Label}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,4"/>
                            <ItemsControl ItemsSource="{Binding PendingRequests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="shared:FamilyJoinRequestDto">
                                        <Border Background="{StaticResource SurfaceCardBrush}"
                                                CornerRadius="{StaticResource Radius.Medium}" Margin="0,4" Padding="12,10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding ApplicantNickName}" FontSize="{StaticResource FontSize.Label}" FontWeight="Medium"/>
                                                    <TextBlock FontSize="{StaticResource FontSize.Caption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                        <Run Text="{Binding BabyName}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding RoleName}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                    <Button Content="{DynamicResource Family_Approve}" Classes="btn primary small"
                                                            Command="{Binding $parent[ItemsControl].((vm:BabyManagerViewModel)DataContext).ApproveRequestCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="{DynamicResource Family_Reject}" Classes="btn small"
                                                            Command="{Binding $parent[ItemsControl].((vm:BabyManagerViewModel)DataContext).RejectRequestCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 我的申请历史 -->
                        <StackPanel IsVisible="{Binding HasMyRequests}" Margin="12,8,12,0">
                            <TextBlock Text="{DynamicResource Family_MyRequests}" FontSize="{StaticResource FontSize.Label}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,4"/>
                            <ItemsControl ItemsSource="{Binding MyRequests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="shared:FamilyJoinRequestDto">
                                        <Border Background="{StaticResource SurfaceCardBrush}"
                                                CornerRadius="{StaticResource Radius.Medium}" Margin="0,4" Padding="12,10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding BabyName}" FontSize="{StaticResource FontSize.Label}" FontWeight="Medium"/>
                                                    <TextBlock FontSize="{StaticResource FontSize.Caption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                                                               Text="{Binding RoleName}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Status, Converter={x:Static vm:JoinRequestStatusConverter.Instance}}"
                                                           FontSize="{StaticResource FontSize.Caption}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Height="12"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 底部添加宝宝按钮（全宽底部按钮用 default 样式，避免 pill+stretch 变椭圆） -->
                <Border Grid.Row="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SurfaceDisabledBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                    <Button Content="{DynamicResource BabyMgr_AddBaby}" Classes="btn secondary large"
                            HorizontalAlignment="Stretch"
                            Click="OnAddTapped"/>
                </Border>
            </Grid>
        </Border>

        <!-- 编辑/添加表单（统一为：标题栏 ✕ 关闭 + 底部 保存按钮，与 RecordSheetView 一致） -->
        <!-- 抽屉动画：mask 淡入淡出 + panel 从底部滑入，由 code-behind 控制 open class -->
        <Border x:Name="EditorSheet" Classes="drawer-mask" IsVisible="{Binding IsEditorOpen}">
            <Border x:Name="DrawerPanel" Classes="drawer-panel" Background="{StaticResource SurfaceCardBrush}" CornerRadius="{StaticResource Radius.XLTop}" VerticalAlignment="Bottom" MaxHeight="600">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- Drag Handle（interaction.md §4 Anatomy，必须） -->
                    <Border Grid.Row="0" Height="4" Width="40" CornerRadius="{StaticResource Radius.Pill}"
                            Background="{StaticResource BorderSubtleBrush}"
                            HorizontalAlignment="Center" Margin="0,8"/>
                    <!-- 标题栏：左标题 + 右关闭按钮（与其他弹窗统一） -->
                    <Border Grid.Row="1" Padding="16,12" BorderBrush="{StaticResource SurfaceDividerBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding EditorTitle}" FontSize="{StaticResource FontSize.CardTitle}" FontWeight="Bold"/>
                            <Button Grid.Column="1" Content="✕" FontSize="18" MinWidth="40" MinHeight="40"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    Command="{Binding CloseEditorCommand}"/>
                        </Grid>
                    </Border>

                    <!-- 表单内容 -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" Margin="20,8,20,16" HorizontalAlignment="Center">

                            <!-- 头像编辑区（点击更换头像） -->
                            <Button Click="OnAvatarTap" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Cursor="Hand">
                                <Border Width="80" Height="80" CornerRadius="{StaticResource Radius.Pill}"
                                        Background="{StaticResource SurfaceCardBrush}"
                                        BorderBrush="{StaticResource SurfaceDividerBrush}" BorderThickness="1">
                                    <Grid>
                                        <!-- 有头像时显示图片 -->
                                        <Image Source="{Binding AvatarBitmap}"
                                               IsVisible="{Binding HasAvatar}"
                                               Stretch="UniformToFill"/>
                                        <!-- 无头像时显示性别 emoji 占位 -->
                                        <TextBlock Text="{Binding GenderEmoji}"
                                                   FontSize="36"
                                                   IsVisible="{Binding !HasAvatar}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Button>
                            <TextBlock Text="{DynamicResource BabyMgr_ChangeAvatar}" FontSize="{StaticResource FontSize.Caption}"
                                       Foreground="{StaticResource TextPlaceholderBrush}"
                                       HorizontalAlignment="Center"/>

                            <!-- 性别选择 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,6">
                                <Button Content="{DynamicResource BabyMgr_Boy}" Classes="gender-btn"
                                        Classes.active="{Binding Gender, Converter={x:Static v:AppConverters.IsBoy}}"
                                        Click="OnBoyTap"/>
                                <Button Content="{DynamicResource BabyMgr_Girl}" Classes="gender-btn" Margin="10,0,0,0"
                                        Classes.active="{Binding Gender, Converter={x:Static v:AppConverters.IsGirl}}"
                                        Click="OnGirlTap"/>
                            </StackPanel>

                            <Border BorderBrush="{StaticResource SurfaceDividerBrush}" BorderThickness="0,1"/>

                            <!-- 姓名 -->
                            <StackPanel Orientation="Horizontal" Height="{StaticResource Size.Form.Field.Height}" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource BabyMgr_Name}" FontSize="{StaticResource FontSize.Body}" Width="{StaticResource Size.Form.Label.Width}" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBox x:Name="BabyNameTextBox" Text="{Binding Name}" PlaceholderText="{DynamicResource BabyMgr_NamePlaceholder}" MaxLength="20"
                                         BorderThickness="0" Background="Transparent" FontSize="{StaticResource FontSize.Body}"
                                         VerticalContentAlignment="Center" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <Border BorderBrush="{StaticResource SurfaceDividerBrush}" BorderThickness="0,1"/>

                            <!-- 出生日期 -->
                            <StackPanel Orientation="Horizontal" Height="48" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource BabyMgr_Birthday}" FontSize="{StaticResource FontSize.Body}" Width="{StaticResource Size.Form.Label.Width}" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <CalendarDatePicker SelectedDate="{Binding BirthDate}"
                                                    PlaceholderText="{DynamicResource BabyMgr_BirthdayPlaceholder}"
                                                    HorizontalAlignment="Stretch" FontSize="{StaticResource FontSize.Body}"/>
                            </StackPanel>

                            <Border BorderBrush="{StaticResource SurfaceDividerBrush}" BorderThickness="0,1"/>

                            <!-- 错误提示 -->
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource SemanticErrorBrush}" FontSize="{StaticResource FontSize.Label}"
                                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                            <!-- 宝宝 ID 行（仅编辑模式可见）：主人可复制给家人用于加入家庭 -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0"
                                  IsVisible="{Binding IsEditing}">
                                <TextBlock Grid.Column="0" Text="{DynamicResource BabyMgr_BabyId}" FontSize="{StaticResource FontSize.Label}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding EditingId}" FontSize="{StaticResource FontSize.Caption}"
                                           Foreground="{StaticResource TextPlaceholderBrush}"
                                           FontFamily="Consolas,Menlo,monospace"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Content="{DynamicResource Common_Copy}" Classes="btn small"
                                        Click="OnCopyEditingIdTap"/>
                            </Grid>

                            <!-- 删除宝宝按钮（仅编辑模式）：危险操作入口
                                 规范 5.1.6: 列表/表单内的危险入口用 Secondary + 红色文字，不用红色实心 -->
                            <Button Content="{DynamicResource BabyMgr_DeleteBaby}" Classes="btn secondary large"
                                    Foreground="{StaticResource SemanticErrorBrush}" BorderBrush="{StaticResource SemanticErrorBrush}"
                                    IsVisible="{Binding IsEditing}"
                                    HorizontalAlignment="Stretch" Margin="0,16,0,0"
                                    Click="OnDeleteTapped"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 底部按钮区：取消 + 保存（与其他弹窗统一） -->
                    <Border Grid.Row="3" Padding="16,12" BorderBrush="{StaticResource SurfaceDividerBrush}" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*,12,*">
                            <Button Grid.Column="0" Content="{DynamicResource Common_Cancel}" Classes="btn secondary large"
                                    Command="{Binding CloseEditorCommand}"/>
                            <Button Grid.Column="2" Content="{DynamicResource Common_Save}" Classes="btn primary large"
                                    Command="{Binding SaveCommand}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- 删除确认对话框 -->
        <controls:DialogHost IsOpen="{Binding IsDeleteConfirmOpen}"
                             Title="{DynamicResource BabyMgr_DeleteTitle}"
                             CancelText="{DynamicResource Common_Cancel}" ConfirmText="{DynamicResource Common_Delete}"
                             CancelCommand="{Binding CloseDeleteConfirmCommand}"
                             ConfirmCommand="{Binding ConfirmDeleteCommand}"
                             IsDangerConfirm="True">
            <controls:DialogHost.MessageContent>
                <TextBlock FontSize="{StaticResource FontSize.Label}" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"
                           Text="{Binding DeleteConfirmName, StringFormat={DynamicResource BabyMgr_DeleteConfirm}}"/>
            </controls:DialogHost.MessageContent>
        </controls:DialogHost>

        <!-- 加入家庭弹窗 -->
        <Border Background="{StaticResource MaskLightBrush}" IsVisible="{Binding IsJoinOpen}">
            <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="{StaticResource Radius.Medium}"
                    Width="320" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Family_JoinFamily}" FontSize="{StaticResource FontSize.CardTitle}" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <TextBlock Text="{DynamicResource Family_BabyId}" FontSize="{StaticResource FontSize.Label}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding JoinBabyId}" PlaceholderText="{DynamicResource Family_JoinPlaceholder}" Margin="0,0,0,12"/>
                    <TextBlock Text="{DynamicResource Family_SelectRole}" FontSize="{StaticResource FontSize.Label}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding RoleOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sharedConst:RoleOption">
                                <Button Content="{Binding Name}" Classes="btn small" Margin="0,0,6,6"
                                        Click="OnSelectJoinRoleTap" Tag="{Binding Code}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding JoinRoleCode, Converter={x:Static vm:RoleNameConverter.Instance}}"
                               FontSize="{StaticResource FontSize.Caption}" Foreground="{StaticResource BrandPrimaryBrush}" Margin="0,4,0,10"/>
                    <TextBlock Text="{Binding JoinError}" FontSize="{StaticResource FontSize.Caption}" Foreground="{StaticResource SemanticErrorBrush}"
                               Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,8,*">
                        <Button Grid.Column="0" Content="{DynamicResource Common_Cancel}" Classes="btn secondary large" Command="{Binding CloseJoinCommand}"/>
                        <Button Grid.Column="2" Content="{DynamicResource Family_JoinNow}" Classes="btn primary large" Command="{Binding ConfirmJoinCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- 修改角色弹窗 -->
        <Border Background="{StaticResource MaskLightBrush}" IsVisible="{Binding IsRoleEditorOpen}">
            <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="{StaticResource Radius.Medium}"
                    Width="320" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding RoleEditorTitle}" FontSize="{StaticResource FontSize.CardTitle}" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <TextBlock Text="{DynamicResource Family_SelectRole}" FontSize="{StaticResource FontSize.Label}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding RoleOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sharedConst:RoleOption">
                                <Button Content="{Binding Name}" Classes="btn small" Margin="0,0,6,6"
                                        Click="OnSelectEditingRoleTap" Tag="{Binding Code}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding EditingRoleCode, Converter={x:Static vm:RoleNameConverter.Instance}}"
                               FontSize="{StaticResource FontSize.Caption}" Foreground="{StaticResource BrandPrimaryBrush}" Margin="0,4,0,16"/>
                    <Grid ColumnDefinitions="*,8,*">
                        <Button Grid.Column="0" Content="{DynamicResource Common_Cancel}" Classes="btn secondary large" Command="{Binding CloseRoleEditorCommand}"/>
                        <Button Grid.Column="2" Content="{DynamicResource Common_Save}" Classes="btn primary large" Command="{Binding ConfirmRoleCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- 移除成员确认弹窗 -->
        <Border Background="{StaticResource MaskBrush}" IsVisible="{Binding IsRemoveConfirmOpen}">
            <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="{StaticResource Radius.XL}"
                    Width="320" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding RemoveConfirmTitle}" FontSize="{StaticResource FontSize.CardTitle}" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <TextBlock Text="{Binding RemoveConfirmBody}" FontSize="{StaticResource FontSize.Label}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                    <Grid ColumnDefinitions="*,8,*">
                        <Button Grid.Column="0" Content="{DynamicResource Common_Cancel}" Classes="btn secondary large" Command="{Binding CloseRemoveConfirmCommand}"/>
                        <Button Grid.Column="2" Content="{Binding RemoveConfirmButtonText}" Classes="btn danger large" Command="{Binding ConfirmRemoveCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Toast -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,80"
                Background="{StaticResource MaskBrush}" CornerRadius="{StaticResource Radius.Small}" Padding="20,10" IsVisible="{Binding ShowToast}">
            <TextBlock Text="{Binding ToastMessage}" Foreground="{StaticResource SurfaceCardBrush}" FontSize="{StaticResource FontSize.Label}"/>
        </Border>
    </Grid>
</UserControl>
