<UserControl x:Class="ChildNotes.Views.MineView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ChildNotes.ViewModels"
             d:DesignHeight="844"
             d:DesignWidth="390"
             x:DataType="vm:MineViewModel"
             Background="{StaticResource SurfaceBackgroundBrush}"
             mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- 顶部用户卡：点击进入账户中心 -->
            <Border Margin="0,0,0,8" Padding="14,16" Background="{StaticResource SurfaceCardBrush}"
                    PointerPressed="OnAccountCenterTap">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!--  原版头像: 绿色渐变背景  -->
                    <Border Grid.Column="0" Width="56" Height="56"
                            Background="{StaticResource BrandPrimaryBrush}"
                            CornerRadius="{StaticResource Radius.Pill}">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="28" Foreground="{StaticResource SurfaceCardBrush}"
                                   Text="👤" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="{StaticResource FontSize.CardTitle}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding NickName}" />
                        <TextBlock Margin="0,4,0,0" FontSize="{StaticResource FontSize.Caption}" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding RoleText}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="20"
                               Foreground="{StaticResource TextPlaceholderBrush}"
                               Text="›" />
                </Grid>
            </Border>

            <Border Classes="section-title">
                <TextBlock Text="{DynamicResource Mine_Section_Baby}" />
            </Border>

            <Border Margin="12,4" Background="{StaticResource SurfaceCardBrush}" CornerRadius="{StaticResource Radius.Medium}">
                <StackPanel>
                    <Grid Margin="14,12" PointerPressed="OnBabyManagerTap">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="20"
                                   Text="👨‍👩‍👧‍👦" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Body}" Text="{DynamicResource Mine_BabyManager}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Label}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding BabyCountText}" />
                        <TextBlock Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="20"
                                   Foreground="{StaticResource TextPlaceholderBrush}"
                                   Text="›" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="section-title">
                <TextBlock Text="{DynamicResource Mine_Section_Growth}" />
            </Border>

            <Border Margin="12,4" Background="{StaticResource SurfaceCardBrush}" CornerRadius="{StaticResource Radius.Medium}">
                <Grid Margin="14,12" PointerPressed="OnDataInsightTap">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="20"
                               Text="📊" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Body}" Text="{DynamicResource DataInsight_Title}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="20"
                               Foreground="{StaticResource TextPlaceholderBrush}"
                               Text="›" />
                </Grid>
            </Border>

            <Border Classes="section-title">
                <TextBlock Text="{DynamicResource Mine_Section_App}" />
            </Border>

            <Border Margin="12,4" Background="{StaticResource SurfaceCardBrush}" CornerRadius="{StaticResource Radius.Medium}">
                <StackPanel>
                    <Grid Margin="14,12" PointerPressed="OnAppSettingsTap">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="20"
                                   Text="⚙️" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Body}" Text="{DynamicResource AppSettings_Title}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="20"
                                   Foreground="{StaticResource TextPlaceholderBrush}"
                                   Text="›" />
                    </Grid>
                    <Border Height="1" Margin="14,0" Background="{StaticResource SurfaceDividerBrush}" />
                    <Grid Margin="14,12" PointerPressed="OnSyncSettingsTap">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="20"
                                   Text="☁️" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Body}" Text="{DynamicResource Mine_SyncSettings}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="20"
                                   Foreground="{StaticResource TextPlaceholderBrush}"
                                   Text="›" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="section-title">
                <TextBlock Text="{DynamicResource Mine_Section_Other}" />
            </Border>

            <Border Margin="12,4" Background="{StaticResource SurfaceCardBrush}" CornerRadius="{StaticResource Radius.Medium}">
                <StackPanel>
                    <Grid Margin="14,12" PointerPressed="OnInAppMessageTap">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="20"
                                   Text="📬" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Body}" Text="{DynamicResource Mine_InAppMessage}" />
                        <Border Grid.Column="2" Height="16" MinWidth="16" Padding="4,0"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Background="{StaticResource SemanticErrorBrush}"
                                CornerRadius="{StaticResource Radius.Small}"
                                IsVisible="{Binding HasUnreadMessages}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Caption}" Foreground="{StaticResource SurfaceCardBrush}"
                                       Text="{Binding UnreadMessageCount}" />
                        </Border>
                        <TextBlock Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="20"
                                   Foreground="{StaticResource TextPlaceholderBrush}"
                                   Text="›" />
                    </Grid>
                    <Border Height="1" Margin="14,0" Background="{StaticResource SurfaceDividerBrush}"/>
                    <Grid Margin="14,12" PointerPressed="OnHelpTap">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="20"
                                   Text="❓" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Body}" Text="{DynamicResource Mine_Help}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="20"
                                   Foreground="{StaticResource TextPlaceholderBrush}"
                                   Text="›" />
                    </Grid>
                    <Border Height="1" Margin="14,0" Background="{StaticResource SurfaceDividerBrush}"/>
                    <Grid Margin="14,12" PointerPressed="OnAboutTap">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="20"
                                   Text="ℹ️" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Body}" Text="{DynamicResource Mine_About}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Label}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding AppVersion}" />
                        <TextBlock Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="20"
                                   Foreground="{StaticResource TextPlaceholderBrush}"
                                   Text="›" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 开发者选项：仅开发版可见，独立卡片放在最底部 -->
            <Border Margin="12,4" Background="{StaticResource SurfaceCardBrush}" CornerRadius="{StaticResource Radius.Medium}"
                    IsVisible="{Binding IsDeveloperOptionsVisible}">
                <Grid Margin="14,12" PointerPressed="OnDeveloperOptionsTap">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="20"
                               Text="🔧" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Body}" Text="{DynamicResource Mine_DeveloperOptions}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="20"
                               Foreground="{StaticResource TextPlaceholderBrush}"
                               Text="›" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
