<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChildNotes.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:Class="ChildNotes.Views.AccountCenterView"
             x:DataType="vm:AccountCenterViewModel"
             Background="{StaticResource SurfaceBackgroundBrush}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 顶栏 -->
        <Border Grid.Row="0" Classes="nav-bar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Classes="nav-back" Command="{Binding BackCommand}"/>
                <TextBlock Grid.Column="1" Classes="nav-title" Text="{DynamicResource Account_Title}"/>
                <TextBlock Grid.Column="2" Text=" " Width="40"/>
            </Grid>
        </Border>

        <!-- 内容区 -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Classes="section-title">
                    <TextBlock Text="{DynamicResource Account_Section_Assets}"/>
                </Border>

                <Border Margin="12,4" Background="{StaticResource SurfaceCardBrush}" CornerRadius="{StaticResource Radius.Medium}">
                    <StackPanel>
                        <!-- 会员中心 -->
                        <Grid Margin="14,12" ColumnDefinitions="Auto,*,Auto,Auto"
                              PointerPressed="OnMembershipTap">
                            <Border Grid.Column="0" Width="24" Height="24"
                                    Background="{StaticResource FeedingOrangeBrush}"
                                    CornerRadius="{StaticResource Radius.XS}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Label}" Foreground="{StaticResource SurfaceCardBrush}"
                                           Text="V"/>
                            </Border>
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Body}"
                                       Text="{DynamicResource Mine_Membership}"/>
                            <TextBlock Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="20"
                                       Foreground="{StaticResource TextPlaceholderBrush}"
                                       Text="›"/>
                        </Grid>
                        <Border Height="1" Margin="14,0" Background="{StaticResource SurfaceDividerBrush}"/>
                        <!-- 积分任务 -->
                        <Grid Margin="14,12" ColumnDefinitions="Auto,*,Auto"
                              PointerPressed="OnPointsTap">
                            <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="20"
                                       Text="🎁"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Body}"
                                       Text="{DynamicResource Mine_Points}"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="20"
                                       Foreground="{StaticResource TextPlaceholderBrush}"
                                       Text="›"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 退出登录：固定底部，红字 secondary 按钮（与原 MineView 退出按钮风格一致） -->
        <Button Grid.Row="2" Margin="12,16" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Classes="btn secondary large"
                Command="{Binding LogoutCommand}"
                Content="{DynamicResource Mine_Logout}"
                Foreground="{StaticResource SemanticErrorBrush}"/>
    </Grid>
</UserControl>
