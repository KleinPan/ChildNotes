<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChildNotes.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:Class="ChildNotes.Views.AccountCenterView"
             x:DataType="vm:AccountCenterViewModel"
             Background="{StaticResource SurfaceBackgroundBrush}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 顶栏 -->
        <Border Grid.Row="0" Classes="nav-bar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Classes="nav-back" Command="{Binding BackCommand}"/>
                <TextBlock Grid.Column="1" Classes="nav-title" Text="{DynamicResource Account_Title}"/>
                <TextBlock Grid.Column="2" Text=" " Width="40"/>
            </Grid>
        </Border>

        <!-- 内容区：会员/积分入口已提级到「我的」页，此处保留空容器（登录/退出登录在底部按钮区） -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel />

        </ScrollViewer>

        <!-- 底部按钮：未登录显示"登录/注册"（主按钮），已登录显示"退出登录"（红字次按钮） -->
        <Button Grid.Row="2" Margin="12,16" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Classes="btn secondary large"
                Command="{Binding LogoutCommand}"
                Content="{DynamicResource Mine_Logout}"
                Foreground="{StaticResource SemanticErrorBrush}"
                IsVisible="{Binding IsLoggedIn}"/>
        <Button Grid.Row="2" Margin="12,16" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Classes="btn primary large"
                Command="{Binding LoginCommand}"
                Content="{DynamicResource Account_LoginRegister}"
                IsVisible="{Binding !IsLoggedIn}"/>
    </Grid>
</UserControl>
