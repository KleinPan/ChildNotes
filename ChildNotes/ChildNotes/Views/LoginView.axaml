<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChildNotes.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:Class="ChildNotes.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             Background="{StaticResource SurfaceBackgroundBrush}">

    <Grid>
        <!-- 返回按钮：本地用户误入登录页后可退出回主界面（离线模式） -->
        <Button Command="{Binding CancelCommand}"
                Background="Transparent" BorderThickness="0"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Padding="12,10" Margin="4,4"
                ZIndex="10">
            <TextBlock Text="‹" FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Button>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid RowDefinitions="*,Auto,*">

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40">
                    <Border Width="84" Height="84" CornerRadius="{StaticResource Radius.Pill}" Background="{StaticResource BrandPrimaryBrush}"
                            HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="👶" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{DynamicResource Login_AppName}" FontSize="{StaticResource FontSize.CardTitle}" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Login_AppSlogan}" FontSize="{StaticResource FontSize.Label}" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Background="{StaticResource SurfaceCardBrush}" CornerRadius="{StaticResource Radius.Medium}"
                        Margin="12,0" Padding="14">
                    <StackPanel>
                        <!-- 邮箱输入 -->
                        <TextBlock Text="{DynamicResource Login_Email}" FontSize="{StaticResource FontSize.Label}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding Email}" PlaceholderText="{DynamicResource Login_EmailPlaceholder}"
                                 CornerRadius="{StaticResource Radius.Medium}" Margin="0,0,0,12"/>

                        <!-- 验证码输入 + 发送按钮（同一行） -->
                        <TextBlock Text="{DynamicResource Login_Code}" FontSize="{StaticResource FontSize.Label}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                            <TextBox Grid.Column="0" Text="{Binding Code}" PlaceholderText="{DynamicResource Login_CodePlaceholder}"
                                     CornerRadius="{StaticResource Radius.Medium}" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="{Binding SendCodeButtonText}"
                                    Classes="btn secondary medium"
                                    Command="{Binding SendCodeCommand}"
                                    IsEnabled="{Binding CanSendCode}"/>
                        </Grid>

                        <!-- 服务器地址配置（可折叠） -->
                        <Button Command="{Binding ToggleServerConfigCommand}" Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Left" Padding="0,4" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="{StaticResource FontSize.Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="{DynamicResource Login_ServerSettings}" FontSize="{StaticResource FontSize.Label}" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" IsVisible="{Binding !ShowServerConfig}"/>
                                <TextBlock Text="{DynamicResource Login_ServerSettingsToggle}" FontSize="{StaticResource FontSize.Label}" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" IsVisible="{Binding ShowServerConfig}"/>
                            </StackPanel>
                        </Button>
                        <StackPanel IsVisible="{Binding ShowServerConfig}" Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource Login_ServerUrlLabel}" FontSize="{StaticResource FontSize.Caption}" Foreground="{StaticResource TextPlaceholderBrush}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding ServerUrl}" PlaceholderText="https://your-server.com"
                                     CornerRadius="{StaticResource Radius.Medium}"/>
                            <TextBlock Text="{DynamicResource Login_ServerUrlHint}" FontSize="{StaticResource FontSize.Caption}"
                                       Foreground="{StaticResource TextPlaceholderBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- 错误信息 -->
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource SemanticErrorBrush}"
                                   FontSize="{StaticResource FontSize.Label}" Margin="0,4"
                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <!-- 登录按钮（统一流程：注册+登录合一） -->
                        <Button Content="{DynamicResource Login_LoginBtn}" Classes="btn primary large"
                                Command="{Binding VerifyCommand}"
                                IsEnabled="{Binding CanVerify}"
                                Margin="0,8,0,12" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="2" Text="{DynamicResource Login_LocalMode}"
                           FontSize="{StaticResource FontSize.Caption}" Foreground="{StaticResource TextPlaceholderBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"/>
            </Grid>
        </ScrollViewer>

        <!-- 开发阶段日志浮层已移除，日志改写入文件（ReleaseLogger），通过开发者选项导出 -->
    </Grid>
</UserControl>
