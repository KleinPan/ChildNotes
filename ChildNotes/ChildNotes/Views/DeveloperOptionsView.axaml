<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChildNotes.ViewModels"
             xmlns:v="using:ChildNotes.Views"
             xmlns:infra="using:ChildNotes.Infrastructure"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:Class="ChildNotes.Views.DeveloperOptionsView"
             x:DataType="vm:DeveloperOptionsViewModel"
             Background="{StaticResource SurfaceBackgroundBrush}">

    <UserControl.Styles>
        <!-- 搜索框：圆角胶囊形，浅灰底，对齐微信风格 -->
        <Style Selector="TextBox.log-search">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceDividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="PlaceholderForeground" Value="{StaticResource TextPlaceholderBrush}"/>
        </Style>

        <!-- 级别筛选按钮：未选中=描边浅灰，选中=实心主色 -->
        <Style Selector="Button.lvl-btn">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.PrimaryButton}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceDividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="RenderTransform" Value="none"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" Easing="QuadraticEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.lvl-btn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.96)"/>
        </Style>
        <!-- 选中态：实心 WeUI 主色（绿），白字，无边框 -->
        <Style Selector="Button.lvl-btn.selected">
            <Setter Property="Background" Value="{StaticResource BrandPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource SurfaceCardBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- 日志列表：ListBox + VirtualizingStackPanel，固定行高，虚拟化生效 -->
        <Style Selector="ListBox.log-list">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
        <Style Selector="ListBox.log-list > ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="ListBox.log-list > ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- 日志条目：两行布局（上 meta 下 msg），白底卡片，行间距 4px -->
        <!-- 固定行高 50px：VirtualizingStackPanel 据此精确计算可视区，2000 条只渲染 ~20 条 -->
        <Style Selector="Border.log-row">
            <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Height" Value="50"/>
        </Style>
        <!-- 选中项（点击展开）：解除固定高度，消息换行显示完整内容 -->
        <Style Selector="ListBox.log-list > ListBoxItem:selected > Border.log-row">
            <Setter Property="Height" Value="NaN"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <!-- 第一行 meta：徽章 + 时间 + Tag，紧凑单行 -->
        <Style Selector="StackPanel.log-meta">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style Selector="TextBlock.log-time">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource TextPlaceholderBrush}"/>
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Menlo,monospace"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.log-tag">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Menlo,monospace"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 第二行 msg：默认单行省略，选中展开时换行显示完整内容 -->
        <Style Selector="TextBlock.log-msg">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Menlo,monospace"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <!-- 选中展开时：消息换行显示完整内容 -->
        <Style Selector="ListBox.log-list > ListBoxItem:selected TextBlock.log-msg">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <!-- 级别徽章文字 -->
        <Style Selector="Border.log-badge TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource SurfaceCardBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 顶栏"清空"按钮：与 nav-back 一致的无边框风格 -->
        <Style Selector="Button.nav-text-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.nav-text-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceActiveBrush}"/>
        </Style>
        <Style Selector="Button.nav-text-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceDividerBrush}"/>
        </Style>
    </UserControl.Styles>

    <!--
        布局：
        Row=0: 顶栏（返回 + 标题 + 清空按钮）
        Row=1: 动画设置（紧凑卡片）
        Row=2: 日志工具栏（搜索框 + 级别筛选）
        Row=3: 日志列表（占满剩余空间，虚拟化）
        Row=4: 底部操作栏（筛选条数 + 导出按钮）
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- 顶栏 -->
        <Border Grid.Row="0" Classes="nav-bar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Classes="nav-back" Command="{Binding BackCommand}"/>
                <TextBlock Grid.Column="1" Classes="nav-title" Text="{DynamicResource Dev_Title}"/>
                <Button Grid.Column="2" Content="{DynamicResource Dev_Clear}" Classes="nav-text-btn"
                        Command="{Binding ClearLogsCommand}"
                        Margin="0,0,4,0"/>
            </Grid>
        </Border>

        <!-- 动画设置（紧凑卡片） -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceCardBrush}"
                CornerRadius="{StaticResource Radius.Medium}" Margin="12,8,12,4">
            <Grid Margin="14,10" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Dev_AnimEnabled}" FontSize="{StaticResource FontSize.Body}"/>
                    <TextBlock Text="{DynamicResource Dev_AnimHint}"
                               FontSize="{StaticResource FontSize.Caption}" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableAnimations}"/>
            </Grid>
        </Border>

        <!-- 日志工具栏：搜索框 + 级别筛选 -->
        <StackPanel Grid.Row="2" Spacing="6" Margin="12,8,12,4">
            <TextBox Text="{Binding SearchText}" PlaceholderText="{DynamicResource Dev_SearchPlaceholder}"
                     Classes="log-search"
                     InnerLeftContent="🔍"
                     Margin="0"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="lvl-btn" Content="{DynamicResource Dev_FilterAll}"
                        Command="{Binding SelectAllLevelCommand}"
                        Classes.selected="{Binding IsAllLevel}"/>
                <Button Classes="lvl-btn" Content="Info"
                        Command="{Binding SelectInfoLevelCommand}"
                        Classes.selected="{Binding IsInfoLevel}"/>
                <Button Classes="lvl-btn" Content="Warn"
                        Command="{Binding SelectWarnLevelCommand}"
                        Classes.selected="{Binding IsWarnLevel}"/>
                <Button Classes="lvl-btn" Content="Error"
                        Command="{Binding SelectErrorLevelCommand}"
                        Classes.selected="{Binding IsErrorLevel}"/>
                <Button Classes="lvl-btn" Content="AI"
                        Command="{Binding SelectAiLevelCommand}"
                        Classes.selected="{Binding IsAiLevel}"/>
            </StackPanel>
        </StackPanel>

        <!--
            日志列表：ListBox + VirtualizingStackPanel，虚拟化 + 固定行高
            - 固定行高 50px 让 VirtualizingStackPanel 精确计算可视区，2000 条只渲染 ~20 条
            - 两行布局：第一行 meta（徽章+时间+Tag）紧凑显示，第二行 msg 占满宽度
            - 点击条目选中 → 选中项解除固定高度 + 消息换行，实现"点击展开查看完整日志"
        -->
        <ListBox Grid.Row="3" Classes="log-list"
                 ItemsSource="{Binding Filtered}"
                 Padding="12,4,12,8"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel CacheLength="0.3"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="infra:DevLogger+LogEntry">
                    <Border Classes="log-row">
                        <StackPanel>
                            <!-- 第一行：级别徽章 + 时间 + Tag（紧凑单行，节省横向空间） -->
                            <StackPanel Classes="log-meta">
                                <Border Classes="log-badge"
                                        Width="40" Height="16" CornerRadius="{StaticResource Radius.XS}"
                                        Background="{Binding Level, Converter={x:Static v:AppConverters.LogLevelToBrush}}">
                                    <TextBlock Text="{Binding Level}"/>
                                </Border>
                                <TextBlock Classes="log-time"
                                           Text="{Binding Time, StringFormat=HH:mm:ss}"/>
                                <TextBlock Classes="log-tag"
                                           Text="{Binding Tag}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <!-- 第二行：消息正文（占满宽度，默认单行省略，选中换行） -->
                            <TextBlock Classes="log-msg"
                                       Text="{Binding Message}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 底部操作栏：筛选条数 + 导出按钮 -->
        <Border Grid.Row="4" Padding="14,10" Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource SurfaceDividerBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           FontSize="{StaticResource FontSize.Caption}" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding Filtered.Count, StringFormat='筛选后 {0} 条'}"/>
                <Button Grid.Column="1" Content="{DynamicResource Dev_ExportTxt}"
                        Classes="btn primary small"
                        Command="{Binding ExportCommand}"
                        IsEnabled="{Binding !IsExporting}"
                        IsVisible="{Binding IsLogExportVisible}"/>
            </Grid>
        </Border>

        <!-- Toast -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="16,0,16,16"
                Background="{StaticResource MaskBrush}" CornerRadius="{StaticResource Radius.Small}" Padding="20,10"
                IsVisible="{Binding ShowToast}">
            <TextBlock Text="{Binding ToastMessage}" Foreground="{StaticResource SurfaceCardBrush}"
                       FontSize="{StaticResource FontSize.Label}" TextWrapping="Wrap" MaxWidth="320"/>
        </Border>
    </Grid>
</UserControl>
