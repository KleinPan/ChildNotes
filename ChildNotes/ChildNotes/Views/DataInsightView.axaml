<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChildNotes.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:Class="ChildNotes.Views.DataInsightView"
             x:DataType="vm:DataInsightViewModel"
             Background="{StaticResource SurfaceBackgroundBrush}">

    <Grid RowDefinitions="Auto,*">

        <!-- 顶栏 -->
        <Border Grid.Row="0" Classes="nav-bar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Classes="nav-back" Command="{Binding BackCommand}"/>
                <TextBlock Grid.Column="1" Classes="nav-title" Text="{DynamicResource DataInsight_Title}"/>
                <TextBlock Grid.Column="2" Text=" " Width="40"/>
            </Grid>
        </Border>

        <!-- 内容区 -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Classes="section-title">
                    <TextBlock Text="{DynamicResource DataInsight_Section_Analysis}"/>
                </Border>

                <Border Margin="12,4" Background="{StaticResource SurfaceCardBrush}" CornerRadius="{StaticResource Radius.Medium}">
                    <StackPanel>
                        <!-- 统计图表 -->
                        <Grid Margin="14,12" ColumnDefinitions="Auto,*,Auto"
                              PointerPressed="OnStatisticsTap">
                            <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="20"
                                       Text="📊"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSize.Body}"
                                           Text="{DynamicResource Mine_Statistics}"/>
                                <TextBlock Margin="0,2,0,0" FontSize="{StaticResource FontSize.Caption}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{DynamicResource DataInsight_Statistics_Sub}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="20"
                                       Foreground="{StaticResource TextPlaceholderBrush}"
                                       Text="›"/>
                        </Grid>
                        <Border Height="1" Margin="14,0" Background="{StaticResource SurfaceDividerBrush}"/>
                        <!-- AI 区间分析报告 -->
                        <Grid Margin="14,12" ColumnDefinitions="Auto,*,Auto"
                              PointerPressed="OnAiAnalysisTap">
                            <Border Grid.Column="0" Width="24" Height="24"
                                    Background="{StaticResource GrowthBlueBrush}"
                                    CornerRadius="{StaticResource Radius.Small}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Label}" Foreground="{StaticResource SurfaceCardBrush}"
                                           Text="{DynamicResource Mine_AiAnalysis_Badge}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSize.Body}"
                                           Text="{DynamicResource Mine_AiAnalysis}"/>
                                <TextBlock Margin="0,2,0,0" FontSize="{StaticResource FontSize.Caption}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{DynamicResource Mine_AiAnalysis_Sub}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="20"
                                       Foreground="{StaticResource TextPlaceholderBrush}"
                                       Text="›"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
