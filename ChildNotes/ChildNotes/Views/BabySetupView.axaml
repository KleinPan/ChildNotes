<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChildNotes.ViewModels"
             xmlns:v="using:ChildNotes.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:Class="ChildNotes.Views.BabySetupView"
             x:DataType="vm:BabySetupViewModel">

    <!-- 对齐小程序 baby-setup: 渐变背景 + 居中卡片 -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="20,30" MaxWidth="360">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="{StaticResource Color.Brand.PrimaryLight}"/>
                    <GradientStop Offset="0.4" Color="{StaticResource Color.Surface.Disabled}"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="{StaticResource Radius.Large}" Padding="20,30"
                    BoxShadow="{StaticResource Shadow.Modal}">
                <StackPanel Spacing="16">

                    <!-- 头部引导 -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,10" Spacing="6">
                        <TextBlock Text="🍼" FontSize="40" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource BabySetup_Welcome}" FontSize="{StaticResource FontSize.SectionTitle}" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource BabySetup_Hint}" FontSize="{StaticResource FontSize.Label}"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- 性别选择 -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                        <TextBlock Text="{DynamicResource BabySetup_Gender}" FontSize="{StaticResource FontSize.Body}" Width="60" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Button Content="{DynamicResource BabyMgr_Boy}" Classes="gender-btn"
                                Classes.active="{Binding Gender, Converter={x:Static v:AppConverters.IsBoy}}"
                                Click="OnBoyTap"/>
                        <Button Content="{DynamicResource BabyMgr_Girl}" Classes="gender-btn" Margin="10,0,0,0"
                                Classes.active="{Binding Gender, Converter={x:Static v:AppConverters.IsGirl}}"
                                Click="OnGirlTap"/>
                    </StackPanel>

                    <Border BorderBrush="{StaticResource SurfaceDisabledBrush}" BorderThickness="0,1"/>

                    <!-- 姓名 -->
                    <StackPanel Orientation="Horizontal" Height="48" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource BabySetup_Name}" FontSize="{StaticResource FontSize.Body}" Width="60" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBox Text="{Binding Name}" PlaceholderText="{DynamicResource BabyMgr_NamePlaceholder}" MaxLength="20"
                                 BorderThickness="0" Background="Transparent" FontSize="{StaticResource FontSize.Body}"
                                 VerticalContentAlignment="Center" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <Border BorderBrush="{StaticResource SurfaceDisabledBrush}" BorderThickness="0,1"/>

                    <!-- 出生日期 -->
                    <StackPanel Orientation="Horizontal" Height="48" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource BabySetup_Birthday}" FontSize="{StaticResource FontSize.Body}" Width="60" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <CalendarDatePicker SelectedDate="{Binding BirthDate}"
                                            PlaceholderText="{DynamicResource BabyMgr_BirthdayPlaceholder}"
                                            HorizontalAlignment="Stretch" FontSize="{StaticResource FontSize.Body}"/>
                    </StackPanel>

                    <Border BorderBrush="{StaticResource SurfaceDisabledBrush}" BorderThickness="0,1"/>

                    <!-- 错误提示 -->
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource SemanticErrorBrush}" FontSize="{StaticResource FontSize.Label}"
                               Margin="0,4"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <!-- 保存按钮 -->
                    <Button Content="{DynamicResource BabySetup_Start}" Classes="btn primary large"
                            Command="{Binding SaveCommand}" IsEnabled="{Binding !Saving}"
                            Margin="0,16,0,0" HorizontalAlignment="Stretch"/>

                    <!-- 跳过 -->
                    <Button Content="{DynamicResource BabySetup_Later}" Background="Transparent" BorderThickness="0" CornerRadius="{StaticResource Radius.Small}"
                            Foreground="{StaticResource TextPlaceholderBrush}" FontSize="{StaticResource FontSize.Label}" Margin="0,4,0,0" MinHeight="40" Padding="20,8"
                            Command="{Binding SkipCommand}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </ScrollViewer>

    <UserControl.Styles>
        <Style Selector="Button.gender-btn">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Background" Value="{StaticResource SurfaceDisabledBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.gender-btn.active">
            <Setter Property="Background" Value="{StaticResource BrandPrimaryLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.gender-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceDisabledBrush}"/>
        </Style>
        <Style Selector="Button.gender-btn.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandPrimaryLightBrush}"/>
        </Style>
    </UserControl.Styles>
</UserControl>
