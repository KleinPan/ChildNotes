<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChildNotes.ViewModels"
             xmlns:s="using:ChildNotes.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:Class="ChildNotes.Views.PointsView"
             x:DataType="vm:PointsViewModel"
             Background="{StaticResource SurfaceBackgroundBrush}">

    <UserControl.Styles>
        <Style Selector="Border.timeline-item">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="Background" Value="{StaticResource SurfaceDisabledBrush}"/>
        </Style>
        <Style Selector="Border.timeline-item.signed">
            <Setter Property="Background" Value="{StaticResource BrandPrimaryBrush}"/>
        </Style>
        <Style Selector="Border.timeline-item.today">
            <Setter Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Border.timeline-item TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Border.timeline-item.signed TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SurfaceCardBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 统一顶栏 -->
        <Border Grid.Row="0" Classes="nav-bar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Classes="nav-back" Command="{Binding BackCommand}"/>
                <TextBlock Grid.Column="1" Classes="nav-title" Text="{DynamicResource Points_Title}"/>
                <TextBlock Grid.Column="2" Text=" " Width="40"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Classes="page-header-banner">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Points_YourPoints}" FontSize="{StaticResource FontSize.Label}" Foreground="{StaticResource TextOnPrimaryBrush}" Opacity="0.8" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="{Binding Points}" FontSize="40" FontWeight="Bold" Foreground="{StaticResource SurfaceCardBrush}"/>
                            <TextBlock Text="{DynamicResource Points_Unit}" FontSize="{StaticResource FontSize.Body}" Foreground="{StaticResource TextOnPrimaryBrush}" Opacity="0.8" VerticalAlignment="Bottom" Margin="4,0,0,8"/>
                        </StackPanel>
                        <TextBlock FontSize="{StaticResource FontSize.Caption}" Foreground="{StaticResource TextOnPrimaryBrush}" Opacity="0.8" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center"
                                   Text="{Binding TotalEarnSpentText}"/>
                    </StackPanel>
                </Border>

                <Border Classes="card" Margin="12,-16,12,8">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Points_Streak}" FontSize="{StaticResource FontSize.Body}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding Timeline}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="s:SignInTimelineItem">
                                    <Border Width="42" Classes="timeline-item"
                                            Classes.signed="{Binding Signed}"
                                            Classes.today="{Binding Today}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSize.Caption}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding DisplayReward}" FontSize="{StaticResource FontSize.Label}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="{Binding SignButtonText}" Classes="btn primary large"
                                Command="{Binding SignInCommand}" IsEnabled="{Binding !TodaySigned}"
                                Margin="0,16,0,0" HorizontalAlignment="Stretch"/>
                        <TextBlock Text="{Binding ContinuousDays, StringFormat=您已连续签到 \{0\} 天}" FontSize="{StaticResource FontSize.Caption}"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Classes="section-title">
                    <TextBlock Text="{DynamicResource Points_TasksEarn}"/>
                </Border>

                <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="{StaticResource Radius.Medium}" Margin="12,4">
                    <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TaskDisplayItem">
                                <Grid Margin="14,12" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSize.Body}" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding Desc}" FontSize="{StaticResource FontSize.Caption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <!-- 已领取：显示"已领取"灰色标签 -->
                                    <Border Grid.Column="1" Background="{StaticResource SurfaceDisabledBrush}" CornerRadius="{StaticResource Radius.Medium}" Padding="10,4"
                                            VerticalAlignment="Center" IsVisible="{Binding IsClaimed}">
                                        <TextBlock Text="{DynamicResource Points_Claimed}" FontSize="{StaticResource FontSize.Caption}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                    <!-- 可领取：显示"领取"按钮 -->
                                    <Button Grid.Column="1" Content="{DynamicResource Points_ClaimButton}"
                                            Classes="btn primary large"
                                            FontSize="{StaticResource FontSize.Label}" VerticalAlignment="Center"
                                            IsVisible="{Binding CanClaim}"
                                            IsEnabled="{Binding !Claiming}"
                                            Command="{Binding ClaimCommand}"
                                            CommandParameter="{Binding}"/>
                                    <!-- 未完成且未领取：显示奖励数值标签 -->
                                    <Border Grid.Column="1" Background="{StaticResource BrandPrimaryLightBrush}" CornerRadius="{StaticResource Radius.Medium}" Padding="10,4"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding ShowRewardLabel}">
                                        <TextBlock Text="{Binding RewardText}" FontSize="{StaticResource FontSize.Label}" Foreground="{StaticResource BrandPrimaryBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,80"
                Background="{StaticResource MaskBrush}" CornerRadius="{StaticResource Radius.Small}" Padding="20,10" IsVisible="{Binding ShowToast}">
            <TextBlock Text="{Binding ToastMessage}" Foreground="{StaticResource SurfaceCardBrush}" FontSize="{StaticResource FontSize.Label}" TextWrapping="Wrap" MaxWidth="320"/>
        </Border>
    </Grid>
</UserControl>
