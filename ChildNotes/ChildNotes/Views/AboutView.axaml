<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChildNotes.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:Class="ChildNotes.Views.AboutView"
             x:DataType="vm:AboutViewModel"
             Background="{StaticResource SurfaceBackgroundBrush}">

    <Grid RowDefinitions="Auto,*">

        <!-- 顶栏 -->
        <Border Grid.Row="0" Classes="nav-bar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Classes="nav-back" Command="{Binding BackCommand}"/>
                <TextBlock Grid.Column="1" Classes="nav-title" Text="{DynamicResource About_Title}"/>
                <TextBlock Grid.Column="2" Text=" " Width="40"/>
            </Grid>
        </Border>

        <!-- 内容区 -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 应用信息区 -->
                <Border Margin="12,16" Padding="20,24"
                        Background="{StaticResource SurfaceCardBrush}"
                        CornerRadius="{StaticResource Radius.Medium}">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <Border Width="64" Height="64"
                                Background="{StaticResource BrandPrimaryBrush}"
                                CornerRadius="{StaticResource Radius.Large}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="32"
                                       Foreground="{StaticResource SurfaceCardBrush}"
                                       Text="📓"/>
                        </Border>
                        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center"
                                   FontSize="{StaticResource FontSize.CardTitle}" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding AppName}"/>
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="{StaticResource FontSize.Label}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding AppVersion}"/>
                    </StackPanel>
                </Border>

                <!-- 法律信息 -->
                <Border Classes="section-title">
                    <TextBlock Text="{DynamicResource About_Section_Legal}"/>
                </Border>

                <Border Margin="12,4" Background="{StaticResource SurfaceCardBrush}" CornerRadius="{StaticResource Radius.Medium}">
                    <StackPanel>
                        <!-- 用户协议 -->
                        <Grid Margin="14,12" ColumnDefinitions="Auto,*,Auto"
                              PointerPressed="OnUserAgreementTap">
                            <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="20"
                                       Text="📑"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Body}"
                                       Text="{DynamicResource Mine_UserAgreement}"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="20"
                                       Foreground="{StaticResource TextPlaceholderBrush}"
                                       Text="›"/>
                        </Grid>
                        <Border Height="1" Margin="14,0" Background="{StaticResource SurfaceDividerBrush}"/>
                        <!-- 隐私政策 -->
                        <Grid Margin="14,12" ColumnDefinitions="Auto,*,Auto"
                              PointerPressed="OnPrivacyPolicyTap">
                            <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="20"
                                       Text="📜"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Body}"
                                       Text="{DynamicResource Mine_PrivacyPolicy}"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="20"
                                       Foreground="{StaticResource TextPlaceholderBrush}"
                                       Text="›"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
