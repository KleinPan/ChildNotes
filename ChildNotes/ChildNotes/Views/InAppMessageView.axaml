<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChildNotes.ViewModels"
             xmlns:v="using:ChildNotes.Views"
             xmlns:m="using:ChildNotes.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:Class="ChildNotes.Views.InAppMessageView"
             x:DataType="vm:InAppMessageViewModel"
             x:Name="root"
             Background="{StaticResource SurfaceBackgroundBrush}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 顶栏 -->
        <Border Grid.Row="0" Classes="nav-bar">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Grid.Column="0" Classes="nav-back" Command="{Binding BackCommand}"/>
                <TextBlock Grid.Column="1" Classes="nav-title" Text="{DynamicResource Msg_Title}"/>
                <!-- 右上角双勾：全部标记已读（只要存在未读消息即可点击） -->
                <Button Grid.Column="2" Classes="icon-only"
                        Margin="0,0,4,0"
                        IsVisible="{Binding HasUnread}"
                        Command="{Binding MarkAllReadCommand}"
                        ToolTip.Tip="{DynamicResource Msg_MarkAllRead}">
                    <PathIcon Width="20" Height="20" Data="{StaticResource icon-check-all}"/>
                </Button>
                <!-- 右上角扫把：清理已读消息 -->
                <Button Grid.Column="3" Classes="icon-only"
                        IsVisible="{Binding HasReadMessages}"
                        Command="{Binding ClearReadMessagesCommand}"
                        ToolTip.Tip="{DynamicResource Msg_ClearRead}">
                    <PathIcon Width="20" Height="20" Data="{StaticResource icon-broom}"/>
                </Button>
            </Grid>
        </Border>

        <!-- 消息列表 -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:InAppMessage">
                            <Border Background="{StaticResource SurfaceCardBrush}"
                                    CornerRadius="{StaticResource Radius.Medium}" Margin="12,4"
                                    Padding="14,12">
                                <Grid RowDefinitions="Auto,Auto,Auto">
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="{StaticResource FontSize.Body}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <!-- 未读小圆点 -->
                                        <Border Grid.Column="1" Width="8" Height="8" CornerRadius="{StaticResource Radius.Pill}"
                                                Background="{StaticResource SemanticErrorBrush}"
                                                IsVisible="{Binding !IsRead}"
                                                VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding Body}" FontSize="{StaticResource FontSize.Label}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayTime}" FontSize="{StaticResource FontSize.Caption}"
                                                   Foreground="{StaticResource TextPlaceholderBrush}"/>
                                        <Button Grid.Column="1" Content="{DynamicResource Common_Delete}" FontSize="{StaticResource FontSize.Caption}"
                                                Classes="btn secondary small"
                                                Command="{Binding $parent[ItemsControl].((vm:InAppMessageViewModel)DataContext).DeleteMessageCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 空状态 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,80,0,0" Spacing="8"
                            IsVisible="{Binding Messages.Count, Converter={x:Static v:InAppMessageView.ZeroToBoolConverter}}">
                    <TextBlock Text="📬" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Msg_Empty}" FontSize="{StaticResource FontSize.Label}" Foreground="{StaticResource TextPlaceholderBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 加载中提示 -->
        <Border Grid.Row="1" Background="{StaticResource MaskBrush}" IsVisible="{Binding IsLoading}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <TextBlock Text="{DynamicResource Common_Loading}" Foreground="{StaticResource SurfaceCardBrush}" FontSize="{StaticResource FontSize.Label}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Toast 浮层 -->
        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,24"
                Background="{StaticResource MaskBrush}" CornerRadius="{StaticResource Radius.Small}" Padding="20,10" IsVisible="{Binding ShowToast}">
            <TextBlock Text="{Binding ToastMessage}" Foreground="{StaticResource SurfaceCardBrush}" FontSize="{StaticResource FontSize.Label}"
                       TextWrapping="Wrap" MaxWidth="320"/>
        </Border>
    </Grid>
</UserControl>
