<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChildNotes.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:Class="ChildNotes.Views.PrivacyConsentView"
             x:DataType="vm:PrivacyConsentViewModel"
             Background="{StaticResource MaskBrush}">

    <!-- 隐私协议弹窗：模态遮罩 + 居中白底卡片，覆盖在整个应用之上 -->
    <Panel>
        <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="{StaticResource Radius.Large}" Padding="24,20"
                MaxWidth="340" MaxHeight="520"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BoxShadow="{StaticResource Shadow.Modal}">

            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">

                <!-- 标题 -->
                <TextBlock Grid.Row="0" Text="{DynamicResource Privacy_Title}" FontSize="{StaticResource FontSize.CardTitle}" FontWeight="Bold"
                           HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>

                <!-- 内容区：摘要视图 / 完整协议视图 二选一 -->
                <Grid Grid.Row="1">
                    <!-- 摘要视图 -->
                    <ScrollViewer IsVisible="{Binding !ShowFullPolicy}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding SummaryText}" FontSize="{StaticResource FontSize.Label}"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="22"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
                                <Button Content="{DynamicResource Privacy_ViewPolicy}" Classes="weui-btn mini default"
                                        Command="{Binding ViewFullPolicyCommand}"/>
                                <Button Content="{DynamicResource Privacy_ViewAgreement}" Classes="weui-btn mini default"
                                        Command="{Binding ViewFullAgreementCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 完整协议视图 -->
                    <ScrollViewer IsVisible="{Binding ShowFullPolicy}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">
                            <!-- 顶部导航 -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{DynamicResource Privacy_BackSummary}" Classes="weui-btn mini default"
                                        Command="{Binding BackToSummaryCommand}"/>
                            </StackPanel>

                            <!-- Tab 切换栏 -->
                            <Grid ColumnDefinitions="*,*" Margin="0,4,0,8">
                                <Button Grid.Column="0" Content="{DynamicResource Privacy_PolicyTab}"
                                        Classes="weui-btn mini"
                                        Command="{Binding SwitchToPolicyTabCommand}"/>
                                <Button Grid.Column="1" Content="{DynamicResource Privacy_AgreementTab}"
                                        Classes="weui-btn mini"
                                        Command="{Binding SwitchToAgreementTabCommand}"/>
                            </Grid>

                            <!-- 协议正文（按 Tab 切换显示） -->
                            <TextBlock Text="{Binding FullPolicyText}"
                                       IsVisible="{Binding IsPolicyTabActive}"
                                       FontSize="{StaticResource FontSize.Label}"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="22"/>
                            <TextBlock Text="{Binding FullAgreementText}"
                                       IsVisible="{Binding IsAgreementTabActive}"
                                       FontSize="{StaticResource FontSize.Label}"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="22"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 按钮区 -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12"
                      IsVisible="{Binding !IsReadOnly}">
                    <Button Grid.Column="0" Content="{DynamicResource Privacy_Disagree}"
                            Classes="weui-btn default" CornerRadius="{StaticResource Radius.Medium}" MinHeight="40"
                            Command="{Binding DisagreeCommand}"/>
                    <Button Grid.Column="1" Content="{DynamicResource Privacy_AgreeContinue}"
                            Classes="weui-btn primary" MinHeight="40"
                            Command="{Binding AgreeCommand}"/>
                </Grid>

                <!-- 只读模式：仅显示关闭按钮 -->
                <Button Grid.Row="2" Content="{DynamicResource Privacy_Close}"
                        Classes="weui-btn primary" MinHeight="40"
                        Command="{Binding CloseCommand}"
                        IsVisible="{Binding IsReadOnly}"/>

            </Grid>
        </Border>
    </Panel>
</UserControl>
