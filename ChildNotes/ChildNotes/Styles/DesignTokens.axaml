<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="ChildNotes.Styles.DesignTokens">

    <!-- ==================================================================
         ChildNotes Design Tokens
         来源: docs/design/design-tokens.md
         规范: 禁止硬编码颜色 / 重复定义间距 / 优先复用组件
         命名: <category>.<role>.<variant?> 与 design-tokens.md 一一对应
         ================================================================== -->

    <!-- ============ Color / Brand ============ -->
    <Color x:Key="Color.Brand.Primary">#00C875</Color>
    <Color x:Key="Color.Brand.PrimaryLight">#E8FFF4</Color>
    <Color x:Key="Color.Brand.PrimaryDark">#00A85A</Color>

    <!-- ============ Color / Secondary 业务色 ============ -->
    <Color x:Key="Color.Growth.Blue">#3B82F6</Color>
    <Color x:Key="Color.Feeding.Orange">#FF9F43</Color>
    <Color x:Key="Color.Sleep.Purple">#8B7CF6</Color>
    <Color x:Key="Color.Medicine.Red">#F56565</Color>
    <Color x:Key="Color.Vaccine.Yellow">#F6C344</Color>

    <!-- ============ Color / Surface ============ -->
    <Color x:Key="Color.Surface.Background">#F5F6F8</Color>
    <Color x:Key="Color.Surface.Card">#FFFFFF</Color>
    <Color x:Key="Color.Surface.Disabled">#F3F4F6</Color>
    <!-- 分隔线/边框淡色（替代 WeuiFg3 #1A000000 / WeuiSeparator #1A000000） -->
    <Color x:Key="Color.Surface.Divider">#1A000000</Color>
    <!-- 按压/选中态浅灰底（替代 WeuiBgColorActive #ECECEC） -->
    <Color x:Key="Color.Surface.Active">#ECECEC</Color>

    <!-- ============ Color / Text ============ -->
    <Color x:Key="Color.Text.Primary">#1F2937</Color>
    <Color x:Key="Color.Text.Secondary">#6B7280</Color>
    <Color x:Key="Color.Text.Placeholder">#9CA3AF</Color>
    <Color x:Key="Color.Text.Success">#16A34A</Color>
    <Color x:Key="Color.Text.Warning">#D97706</Color>
    <Color x:Key="Color.Text.Error">#DC2626</Color>

    <!-- ============ Color / Semantic ============ -->
    <Color x:Key="Color.Semantic.Success">#16A34A</Color>
    <Color x:Key="Color.Semantic.Warning">#D97706</Color>
    <Color x:Key="Color.Semantic.Error">#DC2626</Color>
    <Color x:Key="Color.Semantic.Info">#3B82F6</Color>

    <!-- ============ Color / AI ============ -->
    <Color x:Key="Color.AI.Primary">#7C5CFF</Color>
    <Color x:Key="Color.AI.Background">#F0FFF0</Color>

    <!-- ============ Color / Loading (启动页专属品牌色) ============ -->
    <!-- 奶油色背景 + 咖啡色文字，与 Android SplashScreen #FFF8E7 保持一致，实现启动屏→LoadingView 无缝过渡 -->
    <Color x:Key="Color.Loading.Background">#FFF8E7</Color>
    <Color x:Key="Color.Loading.TextPrimary">#5D4037</Color>
    <Color x:Key="Color.Loading.TextSecondary">#8D6E63</Color>

    <!-- ============ Color / Brushes (供控件直接引用) ============ -->
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource Color.Brand.Primary}" />
    <SolidColorBrush x:Key="BrandPrimaryLightBrush" Color="{StaticResource Color.Brand.PrimaryLight}" />
    <SolidColorBrush x:Key="BrandPrimaryDarkBrush" Color="{StaticResource Color.Brand.PrimaryDark}" />

    <SolidColorBrush x:Key="GrowthBlueBrush" Color="{StaticResource Color.Growth.Blue}" />
    <SolidColorBrush x:Key="FeedingOrangeBrush" Color="{StaticResource Color.Feeding.Orange}" />
    <SolidColorBrush x:Key="SleepPurpleBrush" Color="{StaticResource Color.Sleep.Purple}" />
    <SolidColorBrush x:Key="MedicineRedBrush" Color="{StaticResource Color.Medicine.Red}" />
    <SolidColorBrush x:Key="VaccineYellowBrush" Color="{StaticResource Color.Vaccine.Yellow}" />

    <!-- ============ Color / Vaccine Status (疫苗业务状态色) ============ -->
    <!-- 疫苗记录卡片状态色：默认/已完成/异常/选中态。DesignTokens 未定义，临时集中管理。 -->
    <Color x:Key="Color.Vaccine.BorderDefault">#EDF1F7</Color>
    <Color x:Key="Color.Vaccine.Done">#9EE6C1</Color>
    <Color x:Key="Color.Vaccine.Abnormal">#FFBF9B</Color>
    <Color x:Key="Color.Vaccine.AbnormalBg">#FFFBE8</Color>
    <Color x:Key="Color.Vaccine.AbnormalBorder">#F4D35E</Color>
    <Color x:Key="Color.Vaccine.SelectedBg">#EEF8FF</Color>
    <Color x:Key="Color.Vaccine.SelectedBorder">#BFE8FF</Color>
    <Color x:Key="Color.Vaccine.SelectedText">#0675B8</Color>

    <SolidColorBrush x:Key="VaccineBorderDefaultBrush" Color="{StaticResource Color.Vaccine.BorderDefault}" />
    <SolidColorBrush x:Key="VaccineDoneBrush" Color="{StaticResource Color.Vaccine.Done}" />
    <SolidColorBrush x:Key="VaccineAbnormalBrush" Color="{StaticResource Color.Vaccine.Abnormal}" />
    <SolidColorBrush x:Key="VaccineAbnormalBgBrush" Color="{StaticResource Color.Vaccine.AbnormalBg}" />
    <SolidColorBrush x:Key="VaccineAbnormalBorderBrush" Color="{StaticResource Color.Vaccine.AbnormalBorder}" />
    <SolidColorBrush x:Key="VaccineSelectedBgBrush" Color="{StaticResource Color.Vaccine.SelectedBg}" />
    <SolidColorBrush x:Key="VaccineSelectedBorderBrush" Color="{StaticResource Color.Vaccine.SelectedBorder}" />
    <SolidColorBrush x:Key="VaccineSelectedTextBrush" Color="{StaticResource Color.Vaccine.SelectedText}" />

    <!-- ============ Color / QuickAction (首页快捷动作图标背景色) ============ -->
    <!-- QuickMenuViewModel 中 10 个快捷动作的图标背景色。ViewModel 通过 IconBg 字段存色值字符串。 -->
    <Color x:Key="Color.QuickAction.Feed">#FFF0E6</Color>
    <Color x:Key="Color.QuickAction.Activity">#E3F2FD</Color>
    <Color x:Key="Color.QuickAction.Complementary">#FFF3E0</Color>
    <Color x:Key="Color.QuickAction.Pump">#E8F5E9</Color>
    <Color x:Key="Color.QuickAction.Supplement">#F3E5F5</Color>
    <Color x:Key="Color.QuickAction.Temperature">#FFE8E8</Color>
    <Color x:Key="Color.QuickAction.Sleep">#E8F0FE</Color>
    <Color x:Key="Color.QuickAction.Diaper">#FFF8E1</Color>
    <Color x:Key="Color.QuickAction.Water">#E1F5FE</Color>
    <Color x:Key="Color.QuickAction.Growth">#E0F2F1</Color>

    <SolidColorBrush x:Key="QuickActionFeedBrush" Color="{StaticResource Color.QuickAction.Feed}" />
    <SolidColorBrush x:Key="QuickActionActivityBrush" Color="{StaticResource Color.QuickAction.Activity}" />
    <SolidColorBrush x:Key="QuickActionComplementaryBrush" Color="{StaticResource Color.QuickAction.Complementary}" />
    <SolidColorBrush x:Key="QuickActionPumpBrush" Color="{StaticResource Color.QuickAction.Pump}" />
    <SolidColorBrush x:Key="QuickActionSupplementBrush" Color="{StaticResource Color.QuickAction.Supplement}" />
    <SolidColorBrush x:Key="QuickActionTemperatureBrush" Color="{StaticResource Color.QuickAction.Temperature}" />
    <SolidColorBrush x:Key="QuickActionSleepBrush" Color="{StaticResource Color.QuickAction.Sleep}" />
    <SolidColorBrush x:Key="QuickActionDiaperBrush" Color="{StaticResource Color.QuickAction.Diaper}" />
    <SolidColorBrush x:Key="QuickActionWaterBrush" Color="{StaticResource Color.QuickAction.Water}" />
    <SolidColorBrush x:Key="QuickActionGrowthBrush" Color="{StaticResource Color.QuickAction.Growth}" />

    <!-- 业务色 Light (强调态浅色底/边)
         来源: 业务色 8% 透明叠白色 = Material Design Light 推导值
         design-tokens.md 未明确规定,临时值,待设计确认 -->
    <Color x:Key="Color.Growth.BlueLight">#E0F2FE</Color>
    <Color x:Key="Color.Feeding.OrangeLight">#FFF3E0</Color>
    <Color x:Key="Color.Medicine.RedLight">#FED7D7</Color>
    <Color x:Key="Color.Brand.PrimaryAlpha14">#1400C875</Color>

    <SolidColorBrush x:Key="GrowthBlueLightBrush" Color="{StaticResource Color.Growth.BlueLight}" />
    <SolidColorBrush x:Key="FeedingOrangeLightBrush" Color="{StaticResource Color.Feeding.OrangeLight}" />
    <SolidColorBrush x:Key="MedicineRedLightBrush" Color="{StaticResource Color.Medicine.RedLight}" />
    <SolidColorBrush x:Key="BrandPrimaryAlpha14Brush" Color="{StaticResource Color.Brand.PrimaryAlpha14}" />

    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="{StaticResource Color.Surface.Background}" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource Color.Surface.Card}" />
    <SolidColorBrush x:Key="SurfaceDisabledBrush" Color="{StaticResource Color.Surface.Disabled}" />
    <SolidColorBrush x:Key="SurfaceDividerBrush" Color="{StaticResource Color.Surface.Divider}" />
    <SolidColorBrush x:Key="SurfaceActiveBrush" Color="{StaticResource Color.Surface.Active}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="TextPlaceholderBrush" Color="{StaticResource Color.Text.Placeholder}" />
    <SolidColorBrush x:Key="TextSuccessBrush" Color="{StaticResource Color.Text.Success}" />
    <SolidColorBrush x:Key="TextWarningBrush" Color="{StaticResource Color.Text.Warning}" />
    <SolidColorBrush x:Key="TextErrorBrush" Color="{StaticResource Color.Text.Error}" />

    <SolidColorBrush x:Key="SemanticSuccessBrush" Color="{StaticResource Color.Semantic.Success}" />
    <SolidColorBrush x:Key="SemanticWarningBrush" Color="{StaticResource Color.Semantic.Warning}" />
    <SolidColorBrush x:Key="SemanticErrorBrush" Color="{StaticResource Color.Semantic.Error}" />
    <SolidColorBrush x:Key="SemanticInfoBrush" Color="{StaticResource Color.Semantic.Info}" />

    <SolidColorBrush x:Key="AIPrimaryBrush" Color="{StaticResource Color.AI.Primary}" />
    <SolidColorBrush x:Key="AIBackgroundBrush" Color="{StaticResource Color.AI.Background}" />

    <SolidColorBrush x:Key="LoadingBackgroundBrush" Color="{StaticResource Color.Loading.Background}" />
    <SolidColorBrush x:Key="LoadingTextPrimaryBrush" Color="{StaticResource Color.Loading.TextPrimary}" />
    <SolidColorBrush x:Key="LoadingTextSecondaryBrush" Color="{StaticResource Color.Loading.TextSecondary}" />

    <!-- ============ Color / Mask (遮罩层) ============ -->
    <!-- design-tokens.md 未规定, 临时值 (Material Design Dialog scrim) -->
    <Color x:Key="Color.Mask.Default">#CC000000</Color>
    <Color x:Key="Color.Mask.Light">#80000000</Color>
    <Color x:Key="Color.Brand.PrimaryAlpha10">#1A00C875</Color>

    <SolidColorBrush x:Key="MaskBrush" Color="{StaticResource Color.Mask.Default}" />
    <SolidColorBrush x:Key="MaskLightBrush" Color="{StaticResource Color.Mask.Light}" />
    <SolidColorBrush x:Key="BrandPrimaryAlpha10Brush" Color="{StaticResource Color.Brand.PrimaryAlpha10}" />

    <!-- ============ Spacing (基础单位 4px) ============ -->
    <x:Double x:Key="Spacing.XS">4</x:Double>
    <x:Double x:Key="Spacing.SM">8</x:Double>
    <x:Double x:Key="Spacing.MD">12</x:Double>
    <x:Double x:Key="Spacing.LG">16</x:Double>
    <x:Double x:Key="Spacing.LG2">20</x:Double>
    <x:Double x:Key="Spacing.XL">24</x:Double>
    <x:Double x:Key="Spacing.XXL">32</x:Double>
    <x:Double x:Key="Spacing.3XL">40</x:Double>
    <x:Double x:Key="Spacing.4XL">48</x:Double>

    <Thickness x:Key="Spacing.PageMargin">16,0,16,0</Thickness>
    <Thickness x:Key="Spacing.CardMargin">16,12,16,12</Thickness>
    <Thickness x:Key="Spacing.SectionSpacing">0,24,0,0</Thickness>

    <!-- ============ Radius (圆角体现亲和感) ============ -->
    <CornerRadius x:Key="Radius.Small">8</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">16</CornerRadius>
    <CornerRadius x:Key="Radius.Large">24</CornerRadius>
    <CornerRadius x:Key="Radius.PrimaryButton">24</CornerRadius>
    <CornerRadius x:Key="Radius.SecondaryButton">8</CornerRadius>

    <!-- ============ Typography / FontSize ============ -->
    <x:Double x:Key="FontSize.LargeTitle">24</x:Double>
    <x:Double x:Key="FontSize.SectionTitle">20</x:Double>
    <x:Double x:Key="FontSize.CardTitle">17</x:Double>
    <x:Double x:Key="FontSize.Body">16</x:Double>
    <x:Double x:Key="FontSize.Caption">14</x:Double>
    <x:Double x:Key="FontSize.Label">13</x:Double>
    <x:Double x:Key="FontSize.Minor">12</x:Double>
    <x:Double x:Key="FontSize.Button">16</x:Double>

    <!-- ============ Typography / FontWeight (Avalonia 用 FontWeight 枚举字符串) ============ -->
    <!-- 使用 FontWeights.Normal/Medium/Bold 资源 key,值类型为 Avalonia.Media.FontWeight -->
    <!-- 控件用 FontWeight="{StaticResource FontWeight.Medium}" 引用 -->

    <!-- ============ Component / Button ============ -->
    <x:Double x:Key="Button.Primary.Height">48</x:Double>
    <x:Double x:Key="Button.Primary.MinHeight">48</x:Double>
    <x:Double x:Key="Button.Secondary.Height">44</x:Double>

    <!-- ============ Motion / Duration (毫秒) ============ -->
    <x:Double x:Key="Motion.Duration.Fast">80</x:Double>
    <x:Double x:Key="Motion.Duration.Normal">200</x:Double>
    <x:Double x:Key="Motion.Duration.Slow">400</x:Double>
</ResourceDictionary>
