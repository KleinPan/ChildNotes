<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ChildNotes.Styles.DesignSystemStyles">

    <!-- ==================================================================
         Design System 通用样式（基于 DesignTokens 语义命名）

         Button 体系（components.md 5.1，三维正交）：
           Visual Type（视觉语义，不决定尺寸和形状）：
             primary   品牌色底 + medium 圆角
             secondary 浅灰底 + medium 圆角
             tertiary  透明底 + 品牌色文字
             danger    红色实心 + medium 圆角（仅破坏性最终确认）
             text      无背景，仅文字
           Size（尺寸，与 Visual Type 正交）：
             small  = 32dp / Padding 12,6 / MinWidth 64
             medium = 40dp / Padding 16,12 / MinWidth 72（默认）
             large  = 48dp / Padding 20,12 / MinWidth 88
           Shape（形状，与 Visual Type、Size 正交）：
             （默认） = medium 圆角（12）  ← 所有 Visual Type 默认值
             pill     = radius.pill 圆角  ← FAB/首页核心 CTA 显式指定
           强制规则：
             - Visual Type 不得定义 Height / MinHeight / Padding / MinWidth / CornerRadius（Shape 决定）
             - Height / Padding / MinWidth 一律由 Size 决定
             - CornerRadius 一律由 Shape 决定（默认 medium；需胶囊显式加 .pill）
             - Background / Foreground / Border / 状态色一律由 Visual Type 决定
             - Dialog/弹窗/列表底部全宽按钮 一律不加 pill（避免窄高全宽椭圆视觉）
         Card / Cell / Toast / Tab Bar / Nav Bar 等其他组件：见各段落注释
         ================================================================== -->

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- 去掉所有 Button 在按下/悬停时出现的阴影（Fluent 主题默认会有 elevation 投影） -->
    <Style Selector="Button /template/ ContentPresenter">
        <Setter Property="BoxShadow" Value="{StaticResource Shadow.None}" />
    </Style>

    <!-- ============ Page Header Banner 页面顶部品牌色横幅 ============ -->
    <!-- 用途：AI 详情/会员/积分等页面顶部品牌色 Header。
         圆角仅底部 8dp（贴卡片上沿），Padding 统一 24,24。 -->
    <Style Selector="Border.page-header-banner">
        <Setter Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
        <Setter Property="Padding" Value="24,24" />
        <Setter Property="CornerRadius" Value="0,0,8,8" />
    </Style>

    <!-- ============ Card 通用卡片 ============ -->
    <!-- design-tokens: 普通 Card 圆角 radius.large=16 / 阴影 shadow.card -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Large}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="{StaticResource Spacing.CardMargin}" />
        <Setter Property="BoxShadow" Value="{StaticResource Shadow.Card}" />
    </Style>

    <!-- List Cell：与 Card 同圆角，无阴影 -->
    <Style Selector="Border.cell">
        <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Large}" />
    </Style>

    <!-- 模态遮罩：统一各弹层/对话框的半透明黑色背景（Overlay.Scrim 32% 黑） -->
    <Style Selector="Border.modal-mask">
        <Setter Property="Background" Value="{StaticResource OverlayScrimBrush}" />
    </Style>

    <!-- Toast 浮层：统一各页面 Toast 样式（避免 8+ 处重复定义） -->
    <!-- 用法: <Border Classes="toast" IsVisible="..."><TextBlock .../></Border> -->
    <Style Selector="Border.toast">
        <Setter Property="Background" Value="{StaticResource OverlayScrimBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.toast TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
        <Setter Property="Foreground" Value="{StaticResource SurfaceCardBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="320" />
    </Style>

    <!-- ============ Button 按钮交互反馈 ============ -->
    <!-- 规范：components.md 5.1 Button
       - 视觉类型 × 布局类型 正交
       - 视觉类型: primary / secondary / tertiary / danger / text / icon
       - 布局类型: 由使用方在 XAML 上通过 HorizontalAlignment/Grid 布局决定
       - 尺寸: btn.small (32) / 默认 (40) / btn.large (48)
       - 危险操作入口（列表内"移除/退出"）→ btn.text (红色文字)，不用红色实心
       - 危险操作最终确认（Dialog 内）→ btn.danger (medium 圆角，红色实心) -->
    <!-- Avalonia 12 规范：Transitions + :pressed 伪类 -->
    <!-- 必须设置 RenderTransform="none" 初始值，否则首次过渡从 null 跳变 -->
    <Style Selector="Button.btn">
        <!-- 圆角默认 medium=12（Secondary/普通控件）；Primary/Danger 通过下方专属 Selector 覆盖 -->
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}" />
        <Setter Property="FontWeight" Value="Medium" />
        <!-- Button 文字统一 label=14（design-tokens: Button 文字统一用 font.size.label） -->
        <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <!-- 强制 MinWidth，防止按钮被压缩成圆点（components.md 5.1.2） -->
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="RenderTransform" Value="none"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform"
                                               Duration="0:0:0.08"
                                               Easing="QuadraticEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.btn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)"/>
    </Style>

    <!-- ============ 视觉类型 ============ -->

    <!-- Primary Button: 品牌色底 / 普通圆角 radius.medium / Text.OnPrimary 文字
         用于"保存/确认/提交"等核心动作
         视觉语义：背景/前景/圆角/边框；不决定尺寸（Size 由 small/medium/large 决定）
         圆角策略：默认 medium 普通圆角；需胶囊形态由调用方显式加 .pill Class
         强制规则：不绑定 pill Shape，避免弹窗全宽形成椭圆视觉 -->
    <Style Selector="Button.btn.primary">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}" />
        <Setter Property="Background" Value="{StaticResource ActionPrimaryDefaultBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextOnPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.btn.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ActionPrimaryHoverBrush}" />
    </Style>
    <Style Selector="Button.btn.primary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ActionPrimaryPressedBrush}" />
    </Style>

    <!-- Secondary Button: Action.Secondary 背景 / Text.Primary 文字 / Border.Subtle 边框
         用于"取消/返回/辅助操作"
         Height/MinHeight/Padding 由 Size 决定，正交规则（components.md 5.1.2） -->
    <Style Selector="Button.btn.secondary">
        <Setter Property="Background" Value="{StaticResource ActionSecondaryBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ActionSecondaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.btn.secondary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ActionSecondaryHoverBrush}" />
    </Style>
    <Style Selector="Button.btn.secondary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ActionSecondaryPressedBrush}" />
    </Style>

    <!-- Tertiary Button: 透明底 / 文字 Brand Primary / medium 圆角
         用于"第三级辅助操作"，比 Secondary 更轻量 -->
    <Style Selector="Button.btn.tertiary">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.btn.tertiary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceActiveBrush}" />
    </Style>
    <Style Selector="Button.btn.tertiary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ActionSecondaryPressedBrush}" />
    </Style>

    <!-- Danger Button: 语义错误色底 / medium 圆角（非 pill） / Text.OnPrimary 文字
         仅用于"破坏性操作的最终确认按钮"（Dialog 内的删除/移除/退出确认）
         视觉语义：背景/前景/圆角/边框；不决定尺寸 -->
    <Style Selector="Button.btn.danger">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}" />
        <Setter Property="Background" Value="{StaticResource SemanticErrorBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextOnPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.btn.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SemanticErrorBrush}" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.btn.danger:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SemanticErrorBrush}" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <!-- Text Button: 无背景，仅文字 / 无圆角限制
         用于"轻量操作"（跳过/稍后/查看协议）或"危险操作入口"（列表内"移除"链接）
         配合 .danger 变体可呈现红色文字
         视觉语义：背景/边框；不决定尺寸（Padding/MinWidth 由 Size 决定） -->
    <Style Selector="Button.btn.text">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.btn.text.danger">
        <Setter Property="Foreground" Value="{StaticResource SemanticErrorBrush}" />
    </Style>
    <Style Selector="Button.btn.text:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceActiveBrush}" />
    </Style>

    <!-- ============ 尺寸变体 ============ -->

    <!-- Small: 32dp 高度，紧凑场景（卡片内辅助操作） -->
    <Style Selector="Button.btn.small">
        <Setter Property="Height" Value="{StaticResource Size.Control.Height.Small}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Height.Small}" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    </Style>

    <!-- Large: 48dp 高度，主操作 / Mobile Primary Action -->
    <Style Selector="Button.btn.large">
        <Setter Property="Height" Value="{StaticResource Size.Control.Height.Large}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Height.Large}" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Padding" Value="20,12" />
    </Style>

    <!-- Medium: 40dp 高度（显式 medium Size，与 btn 基类默认值一致）
         用于需要显式声明 medium 的场景（如与 small 混用时强调默认尺寸） -->
    <Style Selector="Button.btn.medium">
        <Setter Property="Height" Value="{StaticResource Size.Control.Height.Medium}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Height.Medium}" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <!-- ============ Shape 形状（与 Visual Type、Size 正交） ============ -->

    <!-- Shape.pill: 独立 Shape 维度，由调用方显式添加 .pill Class
         胶囊形态专用（FAB、首页核心 CTA、独立操作小药丸按钮）
         强制规则：Visual Type 不得默认绑定 pill；
         Dialog/弹窗/列表底部全宽按钮 一律不使用 pill
         用法：<Button Classes="btn primary medium pill" /> -->
    <Style Selector="Button.btn.pill">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    </Style>

    <!-- ============ Tab Bar 底部导航 ============ -->
    <Style Selector="Border.tab-bar">
        <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <!-- 顶部阴影（特殊方向，保留）：原版 0 -2rpx 12rpx rgba(0,0,0,0.04) -->
        <Setter Property="BoxShadow" Value="0 -1 6 0 #0A000000" />
    </Style>

    <Style Selector="Button.tab-item">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
        <Setter Property="Padding" Value="0,6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <!-- 原版 tabBar 高度 100rpx ≈ 50px -->
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="RenderTransform" Value="none"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform"
                                               Duration="0:0:0.15"
                                               Easing="QuadraticEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.tab-item:pressed">
        <Setter Property="RenderTransform" Value="scale(0.9)"/>
    </Style>
    <Style Selector="Button.tab-item PathIcon">
        <Setter Property="Foreground" Value="{StaticResource TextPlaceholderBrush}" />
    </Style>
    <Style Selector="Button.tab-item TextBlock.tab-text">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource TextPlaceholderBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tab-item.active PathIcon">
        <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}" />
    </Style>
    <Style Selector="Button.tab-item.active TextBlock.tab-text">
        <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- ============ Section Title 区块标题 ============ -->
    <Style Selector="Border.section-title">
        <Setter Property="Margin" Value="16,12,16,4" />
    </Style>
    <Style Selector="Border.section-title TextBlock">
        <!-- 模块标题 sectionTitle=20 Bold -->
        <Setter Property="FontSize" Value="{StaticResource FontSize.SectionTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- ============ Navigation Bar 顶栏 ============ -->
    <Style Selector="Border.nav-bar">
        <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}"/>
        <Setter Property="Height" Value="{StaticResource Size.Control.Height.Large}"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style Selector="Border.nav-bar TextBlock.nav-title">
        <!-- 卡片标题 cardTitle=18 Medium（顶栏标题层级） -->
        <Setter Property="FontSize" Value="{StaticResource FontSize.CardTitle}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 统一左上角返回按钮 -->
    <Style Selector="Button.nav-back">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Content" Value="‹"/>
        <Setter Property="MinWidth" Value="40"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style Selector="Button.nav-back:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceActiveBrush}"/>
    </Style>
    <Style Selector="Button.nav-back:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ActionSecondaryPressedBrush}"/>
    </Style>

    <!-- 纯图标按钮（顶栏操作图标，如扫把/设置） -->
    <Style Selector="Button.icon-only">
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="MinWidth" Value="40"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style Selector="Button.icon-only:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceActiveBrush}"/>
    </Style>
    <Style Selector="Button.icon-only:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ActionSecondaryPressedBrush}"/>
    </Style>

    <!-- ============ 开发者选项 / 设置页通用可点击行 ============ -->
    <!-- 注意：ColumnDefinitions 不是 StyledProperty，无法在 Style 中设置，须在 Grid 上直接声明 -->
    <Style Selector="Grid.dev-cell">
        <Setter Property="Margin" Value="14,12"/>
        <Setter Property="RenderTransform" Value="none"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Grid.dev-cell:pointerover">
        <Setter Property="Background" Value="{StaticResource SurfaceActiveBrush}"/>
    </Style>
    <Style Selector="Grid.dev-cell:pressed">
        <Setter Property="Background" Value="{StaticResource ActionSecondaryPressedBrush}"/>
    </Style>
    <!-- dev-cell 内：左图标列 -->
    <Style Selector="Grid.dev-cell > TextBlock.dev-icon">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- dev-cell 内：主标题 -->
    <Style Selector="Grid.dev-cell > StackPanel > TextBlock.dev-title">
        <!-- 正文 body=16 -->
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <!-- dev-cell 内：副描述 -->
    <Style Selector="Grid.dev-cell > StackPanel > TextBlock.dev-desc">
        <!-- 辅助元数据 caption=12 -->
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- dev-cell 内：右侧箭头（统一对齐 baseline，字号 20，灰色 30%） -->
    <Style Selector="Grid.dev-cell > TextBlock.dev-chevron">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="{StaticResource TextPlaceholderBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</Styles>
