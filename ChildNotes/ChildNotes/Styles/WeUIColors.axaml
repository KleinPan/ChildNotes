<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="ChildNotes.Styles.WeUIColors">

    <!-- ==================================================================
         业务专用色（DesignTokens 未明确定义的过渡业务色）
         规范: design-tokens.md "不建立独立 AI 色体系"，AI 相关 UI 复用 Brand/Surface
         迁移说明:
           - AiStatusBgBrush 已删除（违反规范），改用 BrandPrimaryLightBrush
           - StatsAreaBgBrush 已删除（与 SurfaceBackgroundBrush 重复）
           - StatsSplitBrush 已删除（与 BorderSubtleBrush 重复）
           - AvatarGradientBrush 改为 BrandPrimaryBrush 别名（与品牌色统一）
           - Color.AI.* / AIPrimaryBrush / AIBackgroundBrush 已从 DesignTokens 删除
         ================================================================== -->

    <!-- 原版 baby-status-bar 统计卡片左边框色（业务专属强调色，无对应 Secondary Token） -->
    <SolidColorBrush x:Key="FeedAccentBrush" Color="#FF8A3D" />
    <SolidColorBrush x:Key="SleepAccentBrush" Color="#6B8CFF" />
    <SolidColorBrush x:Key="DiaperAccentBrush" Color="#F7B731" />
    <SolidColorBrush x:Key="GrowthAccentBrush" Color="#00A0A0" />

    <!-- 头像渐变（近似单色，绿主色）：与 BrandPrimary #00C875 一致。
         直接使用字面值，避免跨 ResourceDictionary 的 StaticResource 解析问题。 -->
    <SolidColorBrush x:Key="AvatarGradientBrush" Color="#00C875" />
</ResourceDictionary>
