<?xml version="1.0" encoding="utf-8" ?>
<resources>

  <style name="MyTheme">
  </style>

  <!-- SplashScreen 主题：Android 12+ 用系统 SplashScreen API，11 及以下用 windowBackground 兜底。
       postSplashScreenTheme 指向正式主题，启动屏消失后切换。 -->
  <style name="MyTheme.Splash" parent="Theme.SplashScreen">
    <!-- 奶油色背景，与 Avalonia LoadingView 的 #FFF8E7 保持一致，实现启动屏到 LoadingView 的无缝过渡。 -->
    <item name="windowSplashScreenBackground">@color/splash_background</item>
    <!-- 启动屏专用图标：透明背景的笔记本+爱心+脚印。原 @drawable/icon 带粉橙渐变背景，
         在奶油色背景上显示会有明显的方形粉色块突兀感。icon_splash.png 是 AI 抠图后的透明版本。 -->
    <item name="windowSplashScreenAnimatedIcon">@drawable/icon_splash</item>
    <!-- 透明背景：让系统不再绘制圆形 icon_background 遮罩，笔记本边缘自然融入奶油色背景。 -->
    <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    <item name="windowSplashScreenAnimationDuration">0</item>
    <item name="postSplashScreenTheme">@style/MyTheme.NoActionBar</item>
  </style>

  <style name="MyTheme.NoActionBar" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowActionBar">false</item>
    <item name="android:windowBackground">@drawable/splash_screen</item>
    <item name="android:windowNoTitle">true</item>
    <!-- 显式设置状态栏颜色，避免 Android 12+ SplashScreen 消失后奶油色 windowSplashScreenBackground 残留到状态栏。
         值与 Avalonia DesignTokens SurfaceBackgroundBrush (#F5F6F8) 一致，与 MainShellView 背景对齐。 -->
    <item name="android:statusBarColor">@color/app_background</item>
  </style>
</resources>
